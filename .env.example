NODE_ENV=development
PORT=8082
MONGO_CONNECT_URI=mongodb://127.0.0.1:27017/jirello

# Use independent random values of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_SECRET=replace-with-a-separate-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-separate-long-refresh-secret
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=7d

# Comma-separated list. Avoid * in production when credentials are enabled.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
REDIS_URL=redis://localhost:6379
# api | queue-worker | scheduler | outbox-worker | all. Use all only for local development.
PROCESS_ROLE=all
# Defaults to the container hostname or node process ID.
# INSTANCE_ID=jirello-local-1
JSON_LIMIT=1mb
# Number of trusted reverse proxies between the client and Express. Keep 0 locally;
# use 1 when NGINX Gateway Fabric is the only proxy in front of the API.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Protects GET /metrics. Required in production.
# METRICS_TOKEN=replace-with-at-least-thirty-two-random-characters
# Optional external error reporting.
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id

# Pusher Channels. All values are required in production; only PUSHER_KEY is public.
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
PUSHER_USE_TLS=true

# Password recovery. SMTP_HOST and SMTP_FROM are mandatory in production.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_MINUTES=15
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
