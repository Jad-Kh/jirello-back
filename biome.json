{
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "files": {
        "includes": ["src/**/*.ts", "test/**/*.ts", "*.json", "*.md", ".github/**/*.yml"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": { "preset": "none" }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    }
}
